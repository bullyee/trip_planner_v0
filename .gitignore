# Large ML models (cutout) — re-download, do not commit (GitHub rejects >100 MB)
# isnet-anime: https://github.com/danielgatis/rembg/releases/download/v0.0.0/isnet-anime.onnx
assets/models/*.onnx
# 16 KB-aligned libonnxruntime.so (replaces the plugin's crashing 1.15.1);
# re-fetch: extract jni/arm64-v8a/libonnxruntime.so from
# https://repo1.maven.org/maven2/com/microsoft/onnxruntime/onnxruntime-android/1.26.0/onnxruntime-android-1.26.0.aar
android/app/src/main/jniLibs/arm64-v8a/libonnxruntime.so

